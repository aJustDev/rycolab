<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>rycolab</AssemblyName>
    <RootNamespace>Rycolab.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rycolab.Core\Rycolab.Core.csproj" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

  <!-- inpoutx64.dll: the port-access layer ZenStates.Core needs (InpOut32, MIT; see third_party/inpout). -->
  <ItemGroup>
    <None Include="..\..\third_party\inpout\inpoutx64.dll" Link="inpoutx64.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\third_party\inpout\InpOut.LICENSE.txt" Link="InpOut.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
